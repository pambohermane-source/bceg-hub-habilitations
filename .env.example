# --- Base de données ---
# Sur Railway : ajouter le plugin "PostgreSQL", cette variable est injectée automatiquement.
# En local ou sur un serveur externe : renseigner l'URL de connexion Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mettre à "true" uniquement si la base exige une connexion SSL (ex: Postgres managé externe)
PGSSL=false

# --- Authentification ---
# Chaîne aléatoire longue et secrète (obligatoire en production)
JWT_SECRET=change-moi-avec-une-chaine-longue-et-aleatoire

# --- Notification e-mail (optionnel au démarrage — sans ces variables, l'envoi est simulé et journalisé) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BCEG Hub Digital <no-reply@bceg.ga>"

# --- Divers ---
PORT=3000
